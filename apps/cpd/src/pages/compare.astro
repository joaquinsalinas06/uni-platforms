---
import katex from 'katex';
import Base from '../layouts/Base.astro';
import { topicIds, loadMeta } from '../lib/topics';
import { knowledgeMap } from '../lib/knowledge-map';
import { growthWeight } from '../lib/complexity';

function renderMath(tex: string): string {
  try {
    return katex.renderToString(tex, { throwOnError: false, displayMode: false });
  } catch {
    return tex;
  }
}

// A diferencia de EDA-Platform (donde varias estructuras comparten
// exactamente las mismas operaciones — insert, find-min...), en este curso
// cada tema tiene su propio vocabulario de fórmulas (Amdahl vs Gustafson,
// Brent, un colectivo MPI...). No hay una familia natural de columnas
// comparables entre sí, así que esta página agrega TODAS las complejidades
// declaradas en el knowledge map, agrupadas por tema, en vez de forzar una
// matriz cruzada que no aplicaría al material.
const topics = topicIds()
  .map((id) => loadMeta(id))
  .filter((meta) => Object.keys(meta.complexity).length > 0);
---

<Base title="Comparar complejidades" crumb="comparar">
  <header class="stagger mb-12">
    <p class="tag">comparación</p>
    <h1 class="mt-2 max-w-[24ch] text-[clamp(2rem,5vw,3.25rem)] leading-[1.02] font-semibold tracking-[-0.03em]">
      Complejidades del curso
    </h1>
    <p class="mt-5 max-w-[62ch] text-[1.0625rem] leading-relaxed text-[var(--muted)]">
      Cada tema aporta su propio vocabulario de fórmulas — Amdahl y Gustafson no se comparan
      con Brent como si fueran la misma operación. Esta página junta todas las cotas
      declaradas, agrupadas por tema, para tenerlas a la vista sin repetir el razonamiento.
    </p>
  </header>

  <div class="space-y-10">
    {
      topics.map((meta) => {
        const unitTitle = knowledgeMap.units.find((u) => u.id === meta.unit)?.title ?? meta.unit;
        const rows = Object.entries(meta.complexity);
        return (
          <section class="reveal overflow-hidden rounded-lg border border-[var(--rule)]">
            <div class="flex items-baseline justify-between gap-4 border-b border-[var(--rule)] bg-[var(--fill)] px-4 py-2.5">
              <a href={`/topics/${meta.id}`} class="font-medium no-underline hover:text-[var(--accent)]">
                {meta.title} ↗
              </a>
              <span class="tag">{unitTitle}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse">
                <tbody>
                  {rows.map(([op, c]) => (
                    <tr class="border-b border-[var(--rule)] last:border-0 hover:bg-[var(--fill)]">
                      <td class="px-4 py-3.5 font-mono text-[0.9375rem] font-medium whitespace-nowrap">{op}</td>
                      <td class="px-4 py-3.5 text-[1.0625rem] font-medium whitespace-nowrap" set:html={renderMath(c.worst)} />
                      <td class="w-28 px-4 py-3.5">
                        <span class="flex h-1.5 w-24 overflow-hidden rounded-full bg-[var(--sunken)]">
                          <span
                            class="h-full rounded-full bg-[var(--accent)]"
                            style={`width:${growthWeight(c.worst) * 10}%`}
                          />
                        </span>
                      </td>
                      <td class="max-w-[46ch] px-4 py-3.5 text-[0.8125rem] leading-relaxed text-[var(--muted)]">
                        {c.reasoning}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        );
      })
    }
  </div>

  {
    topics.length === 0 && (
      <p class="tag">todavía no hay temas generados con complejidad declarada</p>
    )
  }
</Base>
