---
// Figura real de un examen (captura, topología, gráfica) recortada del PDF
// original. La imagen vive junto al .mdx y se importa: Astro la optimiza en el
// build (AVIF/WebP, srcset) y fija width/height, así que no hay salto de
// layout. Mientras carga se ve un skeleton con shimmer; al cargar, fade-in.
//
//   import topo from './2026-i/p2-topologia.png';
//   <ExamFigure src={topo} alt="…" caption="Figura 1. Distribución" />
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="exam-fig not-prose my-6">
  <a href={src.src} target="_blank" rel="noopener" class="exam-fig-frame" style={`aspect-ratio: ${src.width} / ${src.height}`} title="Abrir en tamaño original">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, src.width].filter((w) => w <= src.width)}
      sizes="(max-width: 860px) 100vw, 820px"
      loading="lazy"
      decoding="async"
      class="exam-fig-img"
      onload="this.classList.add('is-loaded')"
    />
  </a>
  {caption && <figcaption class="tag mt-2 text-center">{caption}</figcaption>}
</figure>

<script is:inline>
  // Imágenes que ya estaban en caché pueden terminar de cargar antes de que
  // el atributo onload se enlace: marcarlas igual.
  document.querySelectorAll('.exam-fig-img').forEach((img) => img.complete && img.naturalWidth && img.classList.add('is-loaded'));
</script>

<style>
  .exam-fig-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    /* Los escaneos son sobre blanco: marco blanco también en modo oscuro. */
    background: #fff;
    padding: 10px;
    box-sizing: content-box;
    max-width: 100%;
  }
  .exam-fig-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, var(--sunken) 30%, var(--fill) 50%, var(--sunken) 70%);
    background-size: 220% 100%;
    animation: exam-shimmer 1.2s linear infinite;
    transition: opacity 0.3s;
  }
  .exam-fig-frame:has(.is-loaded)::before {
    opacity: 0;
    animation: none;
  }
  .exam-fig-frame :global(picture),
  .exam-fig-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .exam-fig-frame :global(img) {
    position: relative;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.35s ease-out;
  }
  .exam-fig-frame :global(img.is-loaded) {
    opacity: 1;
  }
  @keyframes exam-shimmer {
    to {
      background-position: -220% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .exam-fig-frame::before {
      animation: none;
    }
    .exam-fig-frame :global(img) {
      transition: none;
    }
  }
  /* Sin JS no hay onload: mostrar la imagen igual. */
  @media (scripting: none) {
    .exam-fig-frame :global(img) {
      opacity: 1;
    }
  }
</style>
