---
// Único sitio con conocimiento del despacho familia → componente.
//
// El registro real (qué familias existen y si tienen componente) vive en
// src/visualizations/registry.ts, con un `satisfies` que obliga a declarar
// cada miembro de VISUALIZATION_TYPES — añadir uno sin registrar su
// componente ahí es error de compilación, no un fallo silencioso.
//
// Astro necesita resolver el entrypoint de hidratación de `client:visible`
// en tiempo de compilación: pasar el componente como valor dinámico
// (`<Family client:visible ...>`) revienta el build con
// `NoMatchingImport: Could not render 'Family'`. Por eso el despacho en sí
// es una cadena de ifs — pero acotada a este único archivo, y sigue siendo
// el registro quien decide qué familias existen.
//
// Las 13 familias están implementadas (ver registry.ts); si se añade una
// nueva, su import + línea de despacho van aquí, siguiendo el patrón de
// abajo.
import { VISUALIZATIONS } from '../visualizations/registry';
import { visualizationSchema } from '../lib/schemas';
import XyChartVisualization from '../visualizations/xy-chart/XyChartVisualization';
import DagVisualization from '../visualizations/dag/DagVisualization';
import NetworkTopologyVisualization from '../visualizations/network-topology/NetworkTopologyVisualization';
import TimelineVisualization from '../visualizations/timeline/TimelineVisualization';
import MemoryLayoutVisualization from '../visualizations/memory-layout/MemoryLayoutVisualization';
import CircuitVisualization from '../visualizations/circuit/CircuitVisualization';
import CircuitInteractive from '../visualizations/circuit/CircuitInteractive';
import CircuitPractice from '../visualizations/circuit/CircuitPractice';
import SequenceVisualization from '../visualizations/sequence/SequenceVisualization';
import FlowVisualization from '../visualizations/flow/FlowVisualization';
import NetSceneVisualization from '../visualizations/net-scene/NetSceneVisualization';
import SpacetimeVisualization from '../visualizations/spacetime/SpacetimeVisualization';
import WindowVisualization from '../visualizations/window/WindowVisualization';
import PacketVisualization from '../visualizations/packet/PacketVisualization';
import FsmVisualization from '../visualizations/fsm/FsmVisualization';

interface Props {
  viz: { type: keyof typeof VISUALIZATIONS; mode?: string; steps: any[] };
}

const raw = Astro.props.viz;

// Un .mdx pasa el objeto a mano y NO pasa por Zod, así que se queda sin los
// valores por defecto del schema. Validar aquí le da al MDX exactamente el
// mismo contrato que al frontmatter, y un bloque mal escrito revienta el
// build en vez de renderizar nada.
const parsed = visualizationSchema.safeParse(raw);
if (!parsed.success) {
  throw new Error(
    `Bloque visualization inválido en ${Astro.url.pathname}:\n` +
      JSON.stringify(parsed.error.issues, null, 2),
  );
}
const viz = parsed.data;

// El `mode` del bloque es el DEFAULT de todos sus pasos. Los componentes
// sólo reciben `steps`, así que se aplica aquí.
const steps = viz.mode ? viz.steps.map((s) => ({ mode: viz.mode, ...s })) : viz.steps;

const notImplemented = VISUALIZATIONS[viz.type] === null;
---

{viz.type === 'xy-chart' && <XyChartVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'dag' && <DagVisualization client:visible steps={steps} />}
{viz.type === 'network-topology' && <NetworkTopologyVisualization client:visible steps={steps} />}
{viz.type === 'timeline' && <TimelineVisualization client:visible steps={steps} />}
{viz.type === 'memory-layout' && <MemoryLayoutVisualization client:visible steps={steps} />}
{/* circuit: `interactive` (slider) y `practice` (reducir) tienen su propio componente;
    el circuito normal va sólo cuando no hay ninguno de los dos. */}
{viz.type === 'circuit' && !viz.interactive && !viz.practice && <CircuitVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'circuit' && viz.interactive && <CircuitInteractive client:visible steps={steps} interactive={viz.interactive} title={viz.title} />}
{viz.type === 'circuit' && !viz.interactive && viz.practice && <CircuitPractice client:visible steps={steps} practice={viz.practice} title={viz.title} />}
{viz.type === 'sequence' && <SequenceVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'flow' && <FlowVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'net-scene' && <NetSceneVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'spacetime' && <SpacetimeVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'window' && <WindowVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'packet' && <PacketVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}
{viz.type === 'fsm' && <FsmVisualization client:visible steps={steps} title={viz.title} static={viz.static} />}

{
  notImplemented && (
    <p class="tag rounded border border-dashed border-[var(--rule)] bg-[var(--fill)] px-3 py-1.5">
      visualización "{viz.type}" pendiente de implementar
    </p>
  )
}
