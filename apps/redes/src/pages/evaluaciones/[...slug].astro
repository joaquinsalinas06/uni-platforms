---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('evaluaciones');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { pdf, source } = entry.data;
// Tamaño del PDF en el build (cwd = raíz de la app, también en Vercel), para
// que el botón diga cuánto se va a bajar.
const kb = pdf ? Math.round(statSync(join(process.cwd(), 'public', pdf)).size / 1024) : 0;
---

<Base title={entry.data.title} crumb={`evaluaciones/${entry.data.category}`}>
  <header class="stagger mb-12">
    <p class="tag">{entry.data.categoryLabel}</p>
    <h1 class="mt-2 max-w-[32ch] text-[clamp(2.25rem,4.5vw,3.25rem)] leading-[1.05] font-semibold tracking-[-0.035em]">
      {entry.data.title}
    </h1>
    {
      pdf && (
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href={pdf}
            download
            class="inline-flex flex-wrap items-center gap-x-2 gap-y-0.5 rounded-md bg-[var(--accent)] px-4 py-2.5 text-[0.95rem] font-medium text-[var(--accent-ink)] no-underline transition-opacity hover:opacity-90"
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" /></svg>
            <span class="whitespace-nowrap">Descargar examen original</span>
            <span class="font-mono text-[0.8rem] whitespace-nowrap opacity-80">PDF · {kb} KB</span>
          </a>
          <a href={pdf} target="_blank" rel="noopener" class="text-[0.95rem]">Ver en el navegador ↗</a>
          {source && <span class="tag">{source}</span>}
        </div>
      )
    }
    <hr class="draw mt-6 border-0 border-t-2 border-[var(--ink)]" />
  </header>
  <div class="prose max-w-none">
    <Content />
  </div>
</Base>
